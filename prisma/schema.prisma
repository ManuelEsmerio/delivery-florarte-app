generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  name          String
  password      String
  role          String   @default("CUSTOMER")
  phone         String?
  orders        Order[]  @relation("UserOrders")
  deliveries    Order[]  @relation("DriverDeliveries")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id                        Int           @id @default(autoincrement())
  orderToken                String?
  isGuest                   Boolean       @default(false)
  isPickup                  Boolean       @default(false)
  guestName                 String?
  guestEmail                String?
  guestPhone                String?
  sessionId                 String?
  couponCodeSnap            String?
  paymentStatus             PaymentStatus @default(PENDING)
  subtotal                  Decimal       @db.Decimal(10, 2)
  couponDiscount            Decimal       @default(0) @db.Decimal(10, 2)
  shippingCost              Decimal       @default(0) @db.Decimal(10, 2)
  total                     Decimal       @db.Decimal(10, 2)
  deliveryDate              DateTime
  flowerPurchaseDate        DateTime?
  deliveryTimeSlot          String
  dedication                String?       @db.Text
  isAnonymous               Boolean       @default(false)
  signature                 String?       @db.Text
  status                    String        @default("READY_FOR_SHIPMENT")
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  deliveredAt               DateTime?
  deliveryNotes             String?       @db.Text
  
  // NUEVOS CAMPOS DE LOGÍSTICA
  proofOfDeliverySignature  String?       @db.Text
  proofOfDeliveryReceiver   String?
  
  // Relaciones básicas
  userId                    Int?
  user                      User?         @relation("UserOrders", fields: [userId], references: [id])
  deliveryDriverId          Int?
  deliveryDriver            User?         @relation("DriverDeliveries", fields: [deliveryDriverId], references: [id])
  
  items                     OrderItem[]
  orderAddress              OrderAddress?

  // Nota: Si tienes otras tablas (Coupon, Testimonial, etc.), 
  // lo ideal es correr `npx prisma db pull` antes para no perderlas.
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         Int
  order           Order   @relation(fields: [orderId], references: [id])
  productId       Int
  productNameSnap String
  variantNameSnap String?
  quantity        Int
  priceSnap       Decimal @db.Decimal(10, 2)
  imageSnap       String?
}

model OrderAddress {
  id                Int     @id @default(autoincrement())
  orderId           Int     @unique
  order             Order   @relation(fields: [orderId], references: [id])
  recipientName     String
  recipientPhone    String?
  formattedAddress  String  @db.Text
  lat               Float?
  lng               Float?
}
