generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password      String?
  name          String
  role          String   @default("CUSTOMER") // CUSTOMER, DELIVERY, ADMIN
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]  @relation("CustomerOrders")
  deliveries    Order[]  @relation("DriverDeliveries")
}

model Order {
  id                        Int             @id @default(autoincrement())
  status                    String          @default("READY_FOR_SHIPMENT") // READY_FOR_SHIPMENT, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  deliveredAt               DateTime?
  
  // Campos de Comprobante de Entrega
  proofOfDeliverySignature  String?         @db.LongText
  proofOfDeliveryReceiver   String?
  deliveryNotes             String?         @db.Text // Usado para observaciones finales

  // Datos de Invitado (si aplica)
  isGuest                   Boolean         @default(false)
  guestName                 String?
  guestEmail                String?
  guestPhone                String?

  // Datos de la Orden
  deliveryTimeSlot          String
  dedication                String?         @db.Text
  total                     Decimal         @db.Decimal(10, 2)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  // Relaciones
  userId                    Int?
  user                      User?           @relation("CustomerOrders", fields: [userId], references: [id])
  deliveryDriverId          Int?
  deliveryDriver            User?           @relation("DriverDeliveries", fields: [deliveryDriverId], references: [id])
  
  items                     OrderItem[]
  orderAddress              OrderAddress?
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         Int
  order           Order   @relation(fields: [orderId], references: [id])
  productNameSnap String
  variantNameSnap String?
  imageSnap       String?
  quantity        Int
}

model OrderAddress {
  id                Int     @id @default(autoincrement())
  orderId           Int     @unique
  order             Order   @relation(fields: [orderId], references: [id])
  recipientName     String
  recipientPhone    String?
  formattedAddress  String  @db.Text
}
