
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autocoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("DELIVERY") // "ADMIN", "DELIVERY", "CUSTOMER"
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]  @relation("DriverOrders")

  @@map("users")
}

model Order {
  id                        Int           @id @default(autoincrement())
  userId                    Int?
  isGuest                   Boolean       @default(false)
  guestName                 String?
  guestEmail                String?
  guestPhone                String?
  status                    String        // "READY_FOR_SHIPMENT", "OUT_FOR_DELIVERY", "DELIVERED", etc.
  total                     Decimal       @db.Decimal(10, 2)
  subtotal                  Decimal?      @db.Decimal(10, 2)
  shippingCost              Decimal?      @db.Decimal(10, 2)
  couponDiscount            Decimal?      @db.Decimal(10, 2)
  deliveryDate              DateTime?
  deliveryTimeSlot          String?
  dedication                String?       @db.Text
  deliveryNotes             String?       @db.Text
  isAnonymous               Boolean       @default(false)
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  isPickup                  Boolean       @default(false)
  orderToken                String?       @unique
  paymentStatus             String        @default("PENDING")
  deliveryDriverId          Int?
  
  // Nuevos campos para la confirmación de entrega
  proofOfDeliveryReceiver   String?
  proofOfDeliverySignature  String?       @db.Text
  deliveredAt               DateTime?

  user                      User?         @relation(fields: [userId], references: [id])
  deliveryDriver            User?         @relation("DriverOrders", fields: [deliveryDriverId], references: [id])
  items                     OrderItem[]
  orderAddress              OrderAddress?

  @@map("orders")
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         Int
  productNameSnap String
  variantNameSnap String?
  quantity        Int
  priceSnap       Decimal @db.Decimal(10, 2)
  imageSnap       String? @db.Text
  order           Order   @relation(fields: [orderId], references: [id])

  @@map("order_items")
}

model OrderAddress {
  id               Int     @id @default(autoincrement())
  orderId          Int     @unique
  recipientName    String
  recipientPhone   String
  formattedAddress String  @db.Text
  lat              Float?
  lng              Float?
  order            Order   @relation(fields: [orderId], references: [id])

  @@map("order_addresses")
}
