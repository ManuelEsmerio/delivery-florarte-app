
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  role      String   @default("DELIVERY")
  phone     String?
  orders    Order[]  @relation("DriverDeliveries")
  userOrders Order[] @relation("UserOrders")

  @@map("users")
}

model Order {
  id                        Int           @id @default(autoincrement())
  orderToken                String?
  status                    String        @default("READY_FOR_SHIPMENT")
  isGuest                   Boolean       @default(false)
  isPickup                  Boolean       @default(false)
  guestName                 String?
  guestEmail                String?
  guestPhone                String?
  deliveryTimeSlot          String?
  deliveryNotes             String?       @db.Text
  deliveredAt               DateTime?
  dedication                String?       @db.Text
  
  // Nuevos campos para comprobante de entrega
  proofOfDeliverySignature  String?       @db.LongText
  proofOfDeliveryReceiver   String?
  
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  userId                    Int?
  user                      User?         @relation("UserOrders", fields: [userId], references: [id])
  deliveryDriverId          Int?
  deliveryDriver            User?         @relation("DriverDeliveries", fields: [deliveryDriverId], references: [id])
  
  items                     OrderItem[]
  orderAddress              OrderAddress?

  @@map("orders")
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         Int
  order           Order   @relation(fields: [orderId], references: [id])
  productNameSnap String
  variantNameSnap String?
  quantity        Int
  imageSnap       String? @db.Text

  @@map("order_items")
}

model OrderAddress {
  id               Int     @id @default(autoincrement())
  orderId          Int     @unique
  order            Order   @relation(fields: [orderId], references: [id])
  recipientName    String?
  recipientPhone   String?
  formattedAddress String? @db.Text

  @@map("order_addresses")
}
