// Configuración para conectar a base de datos existente sin migraciones automáticas
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Cambia a "mysql" o "sqlite" según tu base de datos
  url      = env("DATABASE_URL")
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique @map("order_number")
  customerName  String      @map("customer_name")
  phone         String
  address       String
  deliveryDate  DateTime    @map("delivery_date")
  deliveryTime  String      @map("delivery_time")
  status        String      // assigned, in_route, delivered, failed
  deliveryNotes String?     @map("delivery_notes")
  lat           Float
  lng           Float
  senderName    String      @map("sender_name")
  senderPhone   String      @map("sender_phone")
  hasCard       Boolean     @default(false) @map("has_card")
  items         OrderItem[]

  @@map("orders") // Nombre real de tu tabla en la DB
}

model OrderItem {
  id        String  @id @default(cuid())
  name      String
  quantity  Int
  imageUrl  String? @map("image_url")
  orderId   String  @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id])

  @@map("order_items") // Nombre real de tu tabla en la DB
}
