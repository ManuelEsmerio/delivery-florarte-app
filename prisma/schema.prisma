generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autocel())
  name      String
  email     String   @unique
  phone     String?
  role      String   @default("CUSTOMER")
  createdAt DateTime @default(now())
  orders    Order[]  @relation("CustomerOrders")
  deliveries Order[] @relation("DriverDeliveries")

  @@map("users")
}

model Order {
  id                        Int             @id @default(autoincrement())
  userId                    Int?
  isGuest                   Boolean         @default(false)
  guestName                 String?
  guestEmail                String?
  guestPhone                String?
  status                    String          @default("READY_FOR_SHIPMENT")
  deliveryNotes             String?         @db.Text
  total                     Decimal         @db.Decimal(10, 2)
  deliveryDate              DateTime
  deliveryTimeSlot          String
  dedication                String?         @db.Text
  proofOfDeliverySignature  String?         @db.LongText
  proofOfDeliveryReceiver   String?
  deliveredAt               DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  
  user                      User?           @relation("CustomerOrders", fields: [userId], references: [id])
  deliveryDriver            User?           @relation("DriverDeliveries", fields: [deliveryDriverId], references: [id])
  deliveryDriverId          Int?
  items                     OrderItem[]
  orderAddress              OrderAddress?

  @@map("orders")
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         Int
  productNameSnap String
  variantNameSnap String?
  quantity        Int
  imageSnap       String? @db.Text
  order           Order   @relation(fields: [orderId], references: [id])

  @@map("order_items")
}

model OrderAddress {
  id               Int     @id @default(autoincrement())
  orderId          Int     @unique
  recipientName    String
  recipientPhone   String
  formattedAddress String  @db.Text
  order            Order   @relation(fields: [orderId], references: [id])

  @@map("order_addresses")
}
