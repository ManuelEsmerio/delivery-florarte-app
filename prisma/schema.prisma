generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String
  password String
  role     String  @default("DELIVERY")
  phone    String?

  @@map("users")
}

model Order {
  id                        Int       @id @default(autoincrement())
  orderToken                String?
  isGuest                   Boolean   @default(true)
  isPickup                  Boolean   @default(false)
  guestName                 String?
  guestEmail                String?
  guestPhone                String?
  sessionId                 String?
  couponCodeSnap            String?
  paymentStatus             String    @default("PENDING")
  subtotal                  Decimal?
  couponDiscount            Decimal?
  shippingCost              Decimal?
  total                     Decimal?
  deliveryDate              DateTime?
  flowerPurchaseDate        DateTime?
  deliveryTimeSlot          String?
  dedication                String?   @db.Text
  isAnonymous               Boolean   @default(false)
  signature                 String?   @db.Text // Campo existente que no debemos usar
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  status                    String    @default("READY_FOR_SHIPMENT")
  
  // Nuevos campos para el comprobante de entrega
  proofOfDeliverySignature  String?   @db.LongText
  proofOfDeliveryReceiver   String?
  deliveryNotes             String?   @db.Text
  deliveredAt               DateTime?
  
  // Relaciones (basadas en logs de error)
  deliveryDriverId          Int?

  @@map("orders")
}
