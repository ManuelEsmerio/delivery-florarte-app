
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Puedes cambiarlo a "mysql" o "sqlite" según tu BD
  url      = env("DATABASE_URL")
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerName  String
  phone         String
  address       String
  deliveryDate  String
  deliveryTime  String
  status        String      // 'assigned' | 'in_route' | 'delivered' | 'failed'
  deliveryNotes String?
  lat           Float
  lng           Float
  senderName    String
  senderPhone   String
  hasCard       Boolean     @default(false)
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id       String  @id @default(cuid())
  name     String
  quantity Int
  imageUrl String?
  orderId  String
  order    Order   @relation(fields: [orderId], references: [id])
}
