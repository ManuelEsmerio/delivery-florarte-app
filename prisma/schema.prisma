generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  role      String   @default("DELIVERY")
  phone     String?
  orders    Order[]  @relation("UserOrders")
  deliveries Order[] @relation("DriverDeliveries")
}

model Order {
  id                   Int             @id @default(autoincrement())
  orderToken           String?
  isGuest              Boolean         @default(false)
  isPickup             Boolean         @default(false)
  guestName            String?
  guestEmail           String?
  guestPhone           String?
  sessionId            String?
  couponCodeSnap       String?
  paymentStatus        PaymentStatus   @default(PENDING)
  subtotal             Decimal?        @db.Decimal(10, 2)
  couponDiscount       Decimal?        @db.Decimal(10, 2)
  shippingCost         Decimal?        @db.Decimal(10, 2)
  total                Decimal?        @db.Decimal(10, 2)
  status               String          @default("READY_FOR_SHIPMENT")
  deliveryDate         DateTime?
  flowerPurchaseDate   DateTime?
  deliveryTimeSlot     String
  dedication           String?
  isAnonymous          Boolean         @default(false)
  signature            String?         // Campo existente usado para otro propósito
  deliveryNotes        String?         // Usado para observaciones finales
  deliveredAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  // NUEVOS CAMPOS PARA LOGÍSTICA DE ENTREGA (SOLICITADOS)
  proofOfDeliverySignature String?       @db.LongText
  proofOfDeliveryReceiver  String?

  // Relaciones
  userId               Int?
  user                 User?           @relation("UserOrders", fields: [userId], references: [id])
  deliveryDriverId     Int?
  deliveryDriver       User?           @relation("DriverDeliveries", fields: [deliveryDriverId], references: [id])
  orderAddress         OrderAddress?
  items                OrderItem[]
}

model OrderAddress {
  id               Int     @id @default(autoincrement())
  recipientName    String
  recipientPhone   String?
  formattedAddress String
  orderId          Int     @unique
  order            Order   @relation(fields: [orderId], references: [id])
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  productNameSnap String
  variantNameSnap String?
  imageSnap       String?
  quantity        Int
  orderId         Int
  order           Order   @relation(fields: [orderId], references: [id])
}
