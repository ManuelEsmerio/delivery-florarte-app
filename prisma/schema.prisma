generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  CUSTOMER
  ADMIN
  DELIVERY
}

enum AddressType {
  HOME
  HOTEL
  RESTAURANT
  OFFICE
  HOSPITAL
  FUNERAL_CHAPEL
  SCHOOL
  BANK
  APARTMENT
  OTHER
}

enum ProductStatus {
  PUBLISHED
  HIDDEN
  DRAFT
}

enum OrderStatus {
  CREATED
  PENDING_PAYMENT
  PAYMENT_FAILED
  PAID
  SCHEDULED
  FLOWERS_PURCHASED
  PREPARING
  READY_FOR_SHIPMENT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponScope {
  GLOBAL
  USERS
  CATEGORIES
  PRODUCTS
  SPECIFIC
}

enum CouponStatus {
  ACTIVE
  EXPIRED
  USED
  PAUSED
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  ADJUSTED
  EXPIRED
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  APPROVED
  CANCELED
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id               Int       @id @default(autoincrement())
  firebaseUid      String?   @unique @db.VarChar(128)
  name             String    @db.VarChar(150)
  email            String    @unique @db.VarChar(255)
  passwordHash     String?   @db.VarChar(255)
  phone            String?   @db.VarChar(20)
  birthdate        DateTime?
  role             Role      @default(CUSTOMER)
  profilePicUrl    String?   @db.VarChar(500)
  loyaltyPoints    Int       @default(0)
  isMarketingOptIn Boolean   @default(false)
  emailVerifiedAt      DateTime?
  passwordResetToken      String?   @db.VarChar(255)
  passwordResetExpiry     DateTime?
  emailVerificationToken  String?   @db.VarChar(255)
  emailVerificationExpiry DateTime?
  isDeleted               Boolean   @default(false)
  deletedAt        DateTime?
  tokenVersion     Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  addresses      Address[]
  chatSessions   ChatSession[]
  orders         Order[]          @relation("CustomerOrders")
  deliveries     Order[]          @relation("DeliveryDriverOrders")
  loyaltyHistory LoyaltyHistory[]
  testimonials   Testimonial[]
  couponUsers    CouponUser[]
  couponRedemptions CouponRedemption[]
  wishlistItems  WishlistItem[]
  carts          Cart[]
  adminCancellations OrderCancellationLog[] @relation("AdminCancellations")

  @@index([emailVerificationToken])
  @@index([passwordResetToken])
  @@map("users")
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  selectionKey String @db.VarChar(80)
  createdAt DateTime @default(now())

  @@unique([userId, selectionKey])
  @@index([variantId])
  @@map("wishlist_items")
}

model Address {
  id             Int         @id @default(autoincrement())
  userId         Int
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  alias          String      @db.VarChar(100)
  recipientName  String      @db.VarChar(150)
  recipientPhone String?     @db.VarChar(20)
  streetName     String      @db.VarChar(255)
  streetNumber   String      @db.VarChar(20)
  interiorNumber String?     @db.VarChar(20)
  neighborhood   String      @db.VarChar(150)
  city           String      @db.VarChar(100)
  state          String      @db.VarChar(100)
  country        String      @default("México") @db.VarChar(60)
  postalCode     String      @db.VarChar(10)
  addressType    AddressType @default(HOME)
  referenceNotes String?     @db.Text
  isDefault      Boolean     @default(false)
  latitude       Decimal?    @db.Decimal(10, 8)
  longitude      Decimal?    @db.Decimal(11, 8)
  googlePlaceId  String?     @db.VarChar(255)
  isDeleted      Boolean     @default(false)
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("addresses")
}

model ProductCategory {
  id          Int              @id @default(autoincrement())
  name        String           @db.VarChar(100)
  slug        String           @unique @db.VarChar(120)
  prefix      String           @db.VarChar(10)
  description String?          @db.Text
  imageUrl    String?          @db.VarChar(500)
  parentId    Int?
  parent      ProductCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryHierarchy")
  isShownOnHome  Boolean          @default(false)
  isDeleted   Boolean          @default(false)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  products         Product[]
  couponCategories CouponCategory[]

  @@map("product_categories")
}

model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique @db.VarChar(60)
  products ProductTag[]

  @@map("tags")
}

model Occasion {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  imageUrl    String?  @db.VarChar(500)
  isShownOnHome  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductOccasion[]

  @@map("occasions")
}

model Product {
  id               Int           @id @default(autoincrement())
  name             String        @db.VarChar(255)
  slug             String        @unique @db.VarChar(280)
  code             String        @unique @db.VarChar(50)
  description      String?       @db.Text
  shortDescription String?       @db.VarChar(500)
  price            Decimal       @db.Decimal(10, 2)
  salePrice        Decimal?      @db.Decimal(10, 2)
  stock            Int           @default(0)
  hasVariants      Boolean       @default(false)
  status           ProductStatus @default(DRAFT)
  care             String?       @db.Text
  mainImage        String?       @db.VarChar(500)
  badgeText        String?       @db.VarChar(40)
  isAllowedPhoto   Boolean       @default(false)
  photoPrice       Decimal?      @db.Decimal(10, 2)
  categoryId       Int
  category         ProductCategory @relation(fields: [categoryId], references: [id])
  isDeleted        Boolean       @default(false)
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  variants       ProductVariant[]
  images         ProductImage[]
  specifications ProductSpecification[]
  tags           ProductTag[]
  occasions      ProductOccasion[]
  orderItems     OrderItem[]
  couponProducts CouponProduct[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]

  @@index([status, isDeleted])
  @@index([categoryId, status, isDeleted])
  @@index([createdAt])
  @@map("products")
}

model ProductVariant {
  id               Int      @id @default(autoincrement())
  productId        Int
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name             String   @db.VarChar(100)
  productName      String   @db.VarChar(120)
  code             String?  @unique @db.VarChar(50)
  price            Decimal  @db.Decimal(10, 2)
  salePrice        Decimal? @db.Decimal(10, 2)
  stock            Int      @default(0)
  shortDescription String?  @db.VarChar(500)
  description      String?  @db.Text
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  images         ProductImage[]
  specifications ProductSpecification[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]

  @@map("product_variants")
}

model ProductImage {
  id        Int             @id @default(autoincrement())
  productId Int?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  src       String          @db.VarChar(500)
  alt       String          @db.VarChar(200)
  isPrimary Boolean         @default(false)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())

  @@map("product_images")
}

model ProductSpecification {
  id        Int             @id @default(autoincrement())
  productId Int?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  key       String          @db.VarChar(100)
  value     String          @db.VarChar(500)
  sortOrder Int             @default(0)

  @@map("product_specifications")
}

model ProductTag {
  productId Int
  tagId     Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

model ProductOccasion {
  productId  Int
  occasionId Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@id([productId, occasionId])
  @@map("product_occasions")
}

model Order {
  id                      Int         @id @default(autoincrement())
  orderToken              String?      @unique @default(uuid()) @db.Char(36)
  userId                  Int?
  user                    User?       @relation("CustomerOrders", fields: [userId], references: [id])
  isGuest                 Boolean     @default(false)
  isPickup                Boolean     @default(false)
  guestName               String?     @db.VarChar(150)
  guestEmail              String?     @db.VarChar(255)
  guestPhone              String?     @db.VarChar(30)
  sessionId               String?     @db.VarChar(128)
  deliveryDriverId        Int?
  deliveryDriver          User?       @relation("DeliveryDriverOrders", fields: [deliveryDriverId], references: [id])
  couponId                Int?
  coupon                  Coupon?     @relation(fields: [couponId], references: [id])
  couponRedemptions       CouponRedemption[]
  couponCodeSnap          String?     @db.VarChar(50)
  status                  OrderStatus   @default(CREATED)
  paymentStatus           PaymentStatus @default(PENDING)
  subtotal                Decimal     @db.Decimal(10, 2)
  couponDiscount          Decimal     @default(0) @db.Decimal(10, 2)
  shippingCost            Decimal     @default(0) @db.Decimal(10, 2)
  total                   Decimal     @db.Decimal(10, 2)
  deliveryDate            DateTime    @db.Date
  flowerPurchaseDate      DateTime?   @db.Date
  deliveryTimeSlot        String      @db.VarChar(50)
  dedication              String?     @db.Text
  deliveryNotes           String?     @db.Text
  isAnonymous             Boolean     @default(false)
  signature               String?     @db.VarChar(500)
  deliveredAt             DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  items               OrderItem[]
  orderAddress        OrderAddress?
  paymentTransactions PaymentTransaction[]
  loyaltyHistory      LoyaltyHistory[]
  testimonial         Testimonial?
  cancellationLogs    OrderCancellationLog[]
  cancellations       OrderCancellation[]

  @@index([userId, createdAt])
  @@index([isGuest, createdAt])
  @@index([sessionId, createdAt])
  @@index([status, createdAt])
  @@index([deliveryDate, status])
  @@index([flowerPurchaseDate, status])
  @@map("orders")
}

model RefundRule {
  id               Int      @id @default(autoincrement())
  orderStatus      OrderStatus
  refundPercentage Decimal  @db.Decimal(5, 2)
  createdAt        DateTime @default(now())

  @@unique([orderStatus])
  @@map("refund_rules")
}

model OrderCancellation {
  id               Int      @id @default(autoincrement())
  orderId          Int
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refundPercentage Decimal  @db.Decimal(5, 2)
  refundAmount     Decimal  @db.Decimal(10, 2)
  reason           String?  @db.VarChar(255)
  cancelledBy      String   @db.VarChar(50)
  createdAt        DateTime @default(now())

  @@index([orderId])
  @@map("order_cancellations")
}

model OrderAddress {
  id             Int         @id @default(autoincrement())
  orderId         Int         @unique
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourceAddressId Int?
  alias           String?     @db.VarChar(100)
  recipientName   String      @db.VarChar(150)
  recipientPhone  String?     @db.VarChar(20)
  streetName      String?     @db.VarChar(255)
  streetNumber    String?     @db.VarChar(20)
  interiorNumber  String?     @db.VarChar(20)
  neighborhood    String?     @db.VarChar(150)
  city            String?     @db.VarChar(100)
  state           String?     @db.VarChar(100)
  country         String      @default("México") @db.VarChar(60)
  postalCode     String?     @db.VarChar(10)
  addressType     AddressType?
  referenceNotes  String?     @db.Text
  latitude        Decimal?    @db.Decimal(10, 8)
  longitude       Decimal?    @db.Decimal(11, 8)
  googlePlaceId   String?     @db.VarChar(255)
  formattedAddress String     @db.Text
  isGuestAddress  Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([sourceAddressId])
  @@index([postalCode, city])
  @@map("order_addresses")
}

model OrderItem {
  id              Int             @id @default(autoincrement())
  orderId         Int
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product         @relation(fields: [productId], references: [id])
  variantId       Int?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  productNameSnap String          @db.VarChar(255)
  variantNameSnap String?         @db.VarChar(100)
  imageSnap       String?         @db.VarChar(500)
  quantity        Int
  unitPrice       Decimal         @db.Decimal(10, 2)
  customPhotoUrl  String?         @db.VarChar(500)
  createdAt       DateTime        @default(now())

  @@map("order_items")
}

model Coupon {
  id            Int          @id @default(autoincrement())
  code          String       @unique @db.VarChar(50)
  description   String       @db.Text
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  validFrom     DateTime
  validUntil    DateTime?
  status        CouponStatus @default(ACTIVE)
  scope         CouponScope  @default(GLOBAL)
  maxUses       Int?
  usesCount     Int          @default(0)
  isDeleted     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders           Order[]
  carts            Cart[]
  couponUsers      CouponUser[]
  couponCategories CouponCategory[]
  couponProducts   CouponProduct[]
  redemptions      CouponRedemption[]

  @@map("coupons")
  @@index([scope, status])
}

model CouponRedemption {
  id         Int       @id @default(autoincrement())
  couponId   Int
  userId     Int
  orderId    Int?
  redeemedAt DateTime  @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([couponId, userId])
  @@index([userId])
  @@index([orderId])
  @@map("coupon_redemptions")
}

model Cart {
  id           Int        @id @default(autoincrement())
  userId       Int?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId    String?    @db.VarChar(128)
  status       CartStatus @default(ACTIVE)
  couponId     Int?
  coupon       Coupon?    @relation(fields: [couponId], references: [id])
  couponCode   String?    @db.VarChar(50)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  items        CartItem[]

  @@index([userId, status])
  @@index([sessionId, status])
  @@map("carts")
}

model CartItem {
  id               Int             @id @default(autoincrement())
  cartId           Int
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId        Int
  product          Product         @relation(fields: [productId], references: [id])
  variantId        Int?
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  quantity         Int             @default(1)
  unitPrice        Decimal         @db.Decimal(10, 2)
  isComplement     Boolean         @default(false)
  parentCartItemId Int?
  customPhotoUrl   String?         @db.VarChar(500)
  deliveryDate     DateTime?       @db.Date
  deliveryTimeSlot String?         @db.VarChar(50)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@index([parentCartItemId])
  @@map("cart_items")
}

model CouponUser {
  couponId Int
  userId   Int
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([couponId, userId])
  @@index([userId])
  @@map("coupon_users")
}

model CouponCategory {
  couponId   Int
  categoryId Int
  coupon     Coupon          @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
  @@map("coupon_categories")
}

model CouponProduct {
  couponId  Int
  productId Int
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
  @@map("coupon_products")
}

model LoyaltyHistory {
  id              Int                    @id @default(autoincrement())
  userId          Int
  user            User                   @relation(fields: [userId], references: [id])
  orderId         Int?
  order           Order?                 @relation(fields: [orderId], references: [id])
  points          Int
  transactionType LoyaltyTransactionType
  notes           String?                @db.Text
  createdAt       DateTime               @default(now())

  @@index([userId])
  @@index([orderId])
  @@map("loyalty_history")
}

model LoyaltyProgramConfig {
  id                      Int      @id
  pointsRequiredForCoupon Int      @default(3000)
  couponValue             Decimal  @default(200) @db.Decimal(10, 2)
  pointsToCurrencyRatio   Decimal  @default(1) @db.Decimal(10, 4)
  couponValidityDays      Int      @default(30)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("loyalty_program_config")
}

model Testimonial {
  id        Int               @id @default(autoincrement())
  userId    Int
  user      User              @relation(fields: [userId], references: [id])
  orderId   Int               @unique
  order     Order             @relation(fields: [orderId], references: [id])
  rating    Int
  comment   String            @db.Text
  userName  String
  userProfilePic String?
  status    TestimonialStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("testimonials")
}

model ShippingZone {
  id               Int      @id @default(autoincrement())
  postalCode       String   @db.VarChar(10)
  locality         String   @db.VarChar(150)
  shippingCost     Decimal  @db.Decimal(10, 2)
  isActive         Boolean  @default(true)
  settlementType   String?  @db.VarChar(100)
  municipality     String?  @db.VarChar(150)
  state            String?  @db.VarChar(100)
  stateCode        String?  @db.VarChar(5)
  municipalityCode String?  @db.VarChar(5)
  postalOfficeCode String?  @db.VarChar(10)
  zone             String?  @db.VarChar(50)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([postalCode, locality])
  @@map("shipping_zones")
}

model Announcement {
  id             Int       @id @default(autoincrement())
  title          String    @db.VarChar(255)
  description    String?   @db.Text
  buttonText     String?   @db.VarChar(100)
  buttonLink     String?   @db.VarChar(500)
  imageUrl       String    @db.VarChar(500)
  imageMobileUrl String?   @db.VarChar(500)
  isActive       Boolean   @default(false)
  startAt        DateTime?
  endAt          DateTime?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("announcements")
}

model HeroBanner {
  id          Int      @id @default(autoincrement())
  desktopSrc  String   @db.VarChar(500)
  mobileSrc   String   @db.VarChar(500)
  alt         String   @db.VarChar(255)
  title       String   @db.VarChar(255)
  description String   @db.VarChar(700)
  buttonText  String   @db.VarChar(120)
  buttonLink  String   @db.VarChar(500)
  dataAiHint  String?  @db.VarChar(255)
  showOnHome  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([showOnHome, updatedAt])
  @@map("hero_banners")
}

model PeakDate {
  id                 Int      @id @default(autoincrement())
  name               String   @db.VarChar(100)
  peakDate           DateTime @db.Date
  isCouponRestricted Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("peak_dates")
}

model NewsletterSubscriber {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  isActive    Boolean  @default(true)
  source      String?
  ipAddress   String?
  userAgent   String?
  isConfirmed Boolean  @default(false)
  token       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  unsubAt     DateTime?

  @@map("newsletter_subscribers")
}

model PaymentTransaction {
  id                Int                      @id @default(autoincrement())
  orderId           Int
  order             Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  externalPaymentId String                   @unique @db.VarChar(191)
  gateway           String                   @default("stripe") @db.VarChar(50)
  amount            Decimal                  @db.Decimal(10, 2)
  status            PaymentTransactionStatus @default(PENDING)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  refund            Refund?

  @@index([orderId])
  @@index([orderId, updatedAt])
  @@map("payment_transactions")
}

model Refund {
  id                   Int                @id @default(autoincrement())
  paymentTransactionId Int                @unique
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])
  externalRefundId     String             @unique @db.VarChar(191)
  amount               Decimal            @db.Decimal(10, 2)
  status               RefundStatus
  reason               String?            @db.VarChar(255)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  cancellationLog      OrderCancellationLog?

  @@map("refunds")
}

model OrderCancellationLog {
  id                 Int      @id @default(autoincrement())
  orderId            Int
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refundId           Int?     @unique
  refund             Refund?  @relation(fields: [refundId], references: [id])
  cancelledBy        String   @db.VarChar(10)
  adminId            Int?
  admin              User?    @relation("AdminCancellations", fields: [adminId], references: [id])
  refundPercentage   Decimal? @db.Decimal(5, 2)
  refundAmount       Decimal? @db.Decimal(10, 2)
  cancellationReason String?  @db.VarChar(100)
  customReason       String?  @db.Text
  createdAt          DateTime @default(now())

  @@index([orderId])
  @@map("order_cancellation_logs")
}

model ChatSession {
  id           Int       @id @default(autoincrement())
  phone        String    @unique @db.VarChar(20)
  userId       Int?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  currentState String    @default("WELCOME") @db.VarChar(50)
  lastIntent   String?   @db.VarChar(50)
  lastMessage  String?   @db.Text
  context      String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@map("chat_sessions")
}

model ChatbotWebhookMessage {
  id          Int      @id @default(autoincrement())
  messageId   String   @unique @db.VarChar(100)
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("chatbot_webhook_messages")
}

model CompanyProfile {
  id                 Int       @id @default(autoincrement())
  legalName          String    @db.VarChar(255)
  tradeName          String?   @db.VarChar(255)
  rfc                String    @unique @db.VarChar(20)
  taxRegime          String?   @db.VarChar(100)
  fiscalStreet       String?   @db.VarChar(255)
  fiscalNumber       String?   @db.VarChar(20)
  fiscalNeighborhood String?   @db.VarChar(150)
  fiscalCity         String?   @db.VarChar(100)
  fiscalState        String?   @db.VarChar(100)
  fiscalPostalCode   String?   @db.VarChar(10)
  supportEmail       String?   @db.VarChar(255)
  billingEmail       String?   @db.VarChar(255)
  supportPhone       String?   @db.VarChar(30)
  websiteUrl         String?   @db.VarChar(255)
  csdCertPath        String?   @db.VarChar(500)
  csdKeyPath         String?   @db.VarChar(500)
  csdPassword        String?   @db.VarChar(255)
  csdSeries          String?   @db.VarChar(50)
  csdValidFrom       DateTime?
  csdValidTo         DateTime?
  notes              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  bankAccounts CompanyBankAccount[]

  @@map("company_profile")
}

model CompanyBankAccount {
  id            Int             @id @default(autoincrement())
  profileId     Int
  profile       CompanyProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  alias         String?         @db.VarChar(100)
  bankName      String          @db.VarChar(150)
  accountNumber String?         @db.VarChar(50)
  clabe         String?         @db.VarChar(50)
  beneficiary   String?         @db.VarChar(255)
  referenceHint String?         @db.VarChar(255)
  swiftCode     String?         @db.VarChar(50)
  isDefault     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([profileId])
  @@map("company_bank_accounts")
}

model WhatsappContact {
  id         Int      @id @default(autoincrement())
  phone      String   @unique @db.VarChar(20)
  name       String   @db.VarChar(150)
  orderCount Int      @default(0)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("whatsapp_contacts")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  email     String   @db.VarChar(255)
  subject   String   @db.VarChar(300)
  message   String   @db.Text
  isRead    Boolean  @default(false)
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@map("contact_messages")
}

model CompanyMeta {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_meta")
}
